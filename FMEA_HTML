<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102b2b" />
    <title>FMEA Studio | 智能失效模式分析</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-mark">F</div>
          <div>
            <div class="brand-name">FMEA Studio</div>
            <div class="brand-subtitle">Failure analysis workspace</div>
          </div>
        </div>

        <nav class="nav-list" aria-label="主导航">
          <button class="nav-item active" type="button"><span class="nav-icon">▦</span>分析工作台</button>
          <button class="nav-item" type="button"><span class="nav-icon">◈</span>项目知识库</button>
          <button class="nav-item" type="button"><span class="nav-icon">⌁</span>分析历史</button>
        </nav>

        <div class="sidebar-bottom">
          <div class="standard-badge"><span class="status-dot"></span><div><strong>IEC 60812</strong><small>规则集已加载</small></div></div>
          <div class="user-chip"><div class="avatar">G</div><div><strong>安全工程师</strong><small>本地工作区</small></div><span class="more">•••</span></div>
        </div>
      </aside>

      <main class="main-content">
        <header class="topbar">
          <div>
            <div class="eyebrow">ANALYSIS WORKSPACE <span class="live-pill"><i></i>本地规则引擎</span></div>
            <h1>FMEA 安全分析</h1>
            <p class="topbar-copy">从系统或软件元素出发，快速构建可追溯的失效分析草稿。</p>
          </div>
          <div class="top-actions">
            <button id="resetBtn" class="ghost-btn" type="button"><span>↺</span> 新建分析</button>
            <button id="exportBtn" class="outline-btn" type="button" disabled><span>⇩</span> 导出 CSV</button>
          </div>
        </header>

        <section class="workspace-grid">
          <section class="input-panel panel-section">
            <div class="section-heading">
              <div><span class="section-kicker">01 / CONTEXT</span><h2>定义分析对象</h2></div>
              <span class="required-note">* 必填</span>
            </div>

            <div class="sample-row"><span>快速开始</span><button class="sample-btn" type="button" data-sample="software">软件示例 · 车速计算模块</button><button class="sample-btn" type="button" data-sample="system">系统示例 · 电池管理系统</button></div>

            <form id="fmeaForm">
              <label class="field-label" for="elementName">系统 / 软件元素 <span>*</span></label>
              <input id="elementName" name="elementName" type="text" placeholder="例如：车速计算模块" required />

              <div class="two-col">
                <div><label class="field-label" for="elementType">元素类型</label><select id="elementType" name="elementType"><option value="software">软件元素</option><option value="system">系统元素</option><option value="hardware">硬件组件</option></select></div>
                <div><label class="field-label" for="standard">分析标准</label><select id="standard" name="standard"><option>IEC 60812</option><option>AIAG / VDA</option><option>ISO 26262</option></select></div>
              </div>

              <label class="field-label" for="function">主要功能 <span>*</span></label>
              <textarea id="function" name="function" rows="2" placeholder="描述元素应完成的功能，例如：基于轮速信号计算车辆当前速度"></textarea>

              <div class="two-col">
                <div><label class="field-label" for="inputs">输入 / 依赖</label><textarea id="inputs" name="inputs" rows="3" placeholder="轮速信号、时间戳、标定参数"></textarea></div>
                <div><label class="field-label" for="outputs">输出 / 接口</label><textarea id="outputs" name="outputs" rows="3" placeholder="车辆速度、有效性状态"></textarea></div>
              </div>

              <label class="field-label" for="modes">运行模式</label>
              <input id="modes" name="modes" type="text" placeholder="正常、启动、降级、关闭" />

              <label class="field-label" for="safetyGoal">安全目标 / 关键约束</label>
              <textarea id="safetyGoal" name="safetyGoal" rows="2" placeholder="例如：避免向上层提供错误的车辆速度"></textarea>

              <div class="form-footer"><div class="confidence-note"><span class="info-icon">i</span><span>结果为工程草稿，最终评分与措施需由专家确认。</span></div><button class="primary-btn" type="submit" id="generateBtn"><span class="spark">✦</span> 生成 FMEA 分析</button></div>
            </form>
          </section>

          <section class="results-panel panel-section" aria-live="polite">
            <div id="emptyState" class="empty-state">
              <div class="empty-orbit"><span>F</span><i></i><i></i><i></i></div>
              <h2>等待分析对象</h2>
              <p>输入一个系统或软件元素，Agent 将按失效引导词逐步生成 FMEA 结果。</p>
              <div class="empty-steps"><span><b>1</b>补全上下文</span><span><b>2</b>展开失效模式</span><span><b>3</b>审核安全措施</span></div>
            </div>

            <div id="loadingState" class="loading-state hidden">
              <div class="loader-ring"></div><h2 id="loadingTitle">正在准备分析</h2><p id="loadingText">检查输入上下文...</p><div class="progress-track"><div id="progressBar"></div></div><div id="stepList" class="step-list"></div>
            </div>

            <div id="resultState" class="result-state hidden">
              <div class="result-header"><div><span class="section-kicker">ANALYSIS RESULT</span><h2 id="resultTitle">车速计算模块</h2><div class="result-meta"><span id="resultType">软件元素</span><span>·</span><span id="resultStandard">IEC 60812</span><span>·</span><span id="resultTime">刚刚生成</span></div></div><div class="result-status"><span class="status-dot"></span>草稿 · 待审核</div></div>
              <div class="metric-strip"><div class="metric"><span>分析功能</span><strong id="metricFunctions">1</strong></div><div class="metric"><span>失效模式</span><strong id="metricModes">0</strong></div><div class="metric"><span>高风险项</span><strong id="metricHigh">0</strong></div><div class="metric"><span>平均 RPN</span><strong id="metricRpn">0</strong></div></div>
              <div class="tabs"><button class="tab active" data-tab="table" type="button">FMEA 表格 <span id="tableCount">0</span></button><button class="tab" data-tab="overview" type="button">风险概览</button><button class="tab" data-tab="basis" type="button">分析依据</button></div>

              <div id="tableTab" class="tab-panel"><div class="table-toolbar"><div class="toolbar-caption"><span class="filter-icon">≡</span> 已应用 8 个适用失效引导词</div><button id="copyBtn" class="mini-btn" type="button"><span>□</span> 复制 JSON</button></div><div class="table-wrap"><table><thead><tr><th class="col-id">ID</th><th class="col-mode">潜在失效模式</th><th class="col-cause">潜在失效原因</th><th class="col-effect">潜在失效影响</th><th class="col-control">安全措施 / 机制</th><th class="col-score">S</th><th class="col-score">O</th><th class="col-score">D</th><th class="col-rpn">RPN</th><th>状态</th></tr></thead><tbody id="fmeaBody"></tbody></table></div></div>
              <div id="overviewTab" class="tab-panel hidden"><div class="overview-grid"><div class="overview-block"><div class="overview-title"><span class="section-kicker">RISK DISTRIBUTION</span><h3>风险分布</h3></div><div id="riskBars" class="risk-bars"></div></div><div class="overview-block"><div class="overview-title"><span class="section-kicker">COVERAGE</span><h3>安全机制覆盖</h3></div><div class="coverage-score"><strong id="coverageValue">0%</strong><span>失效原因已关联至少一项控制措施</span></div><div class="coverage-track"><div id="coverageBar"></div></div><div id="coverageHint" class="muted-text"></div></div></div><div class="high-risk-list"><div class="overview-title"><span class="section-kicker">ATTENTION</span><h3>优先关注</h3></div><div id="highRiskList"></div></div></div>
              <div id="basisTab" class="tab-panel hidden"><div class="basis-grid"><div><span class="section-kicker">CONTEXT SNAPSHOT</span><h3>输入上下文</h3><dl id="contextList"></dl></div><div><span class="section-kicker">ASSUMPTIONS</span><h3>分析假设与提醒</h3><ul id="assumptionList" class="assumption-list"></ul></div></div></div>
            </div>
          </section>
        </section>
        <footer class="page-footer"><span>FMEA Studio · 本地原型</span><span>模型输出仅供工程分析辅助，不替代正式安全评审</span></footer>
      </main>
    </div>
    <script src="app.js"></script>
  </body>
</html>
